{
  "name": "mewclient",
  "version": "1.0.2",
  "description": "MewClient — лаунчер Minecraft",
  "author": "MewClient Team",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "clean": "rmdir /s /q dist",
    "rebuild": "npm run clean && npm run build:win",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mewclient.launcher",
    "productName": "MewClient",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": ["x64", "ia32"]
        }
      ]
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Game"
    }
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "discord-rpc": "^4.0.1",
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "minecraft-launcher-core": "^3.18.2"
  }
}